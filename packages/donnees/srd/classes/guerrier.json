  "aptitudes": [
    {
      "id": "style-de-combat",
      "nom": "Style de combat",
      "niveau": 1,
      "resume": "Vous recevez un don de Style de combat de votre choix (Défense recommandé), que vous pouvez remplacer par un autre à chaque niveau de Guerrier gagné.",
      "effets": []
    },
    {
      "id": "second-souffle",
      "nom": "Second souffle",
      "niveau": 1,
      "resume": "Par une action Bonus, vous récupérez 1d10 + votre niveau de Guerrier points de vie. Deux utilisations (colonne Second souffle), une regagnée au Repos court et toutes au Repos long.",
      "effets": []
    },
    {
      "id": "bottes-d-arme",
      "nom": "Bottes d’arme",
      "niveau": 1,
      "resume": "Vous pouvez exploiter la botte de trois types d’arme courante ou de guerre de votre choix (nombre selon la colonne Bottes d’arme). Vous pouvez changer l’un de ces choix à chaque Repos long.",
      "effets": []
    },
    {
      "id": "fougue",
      "nom": "Fougue",
      "niveau": 2,
      "resume": "À votre tour, vous pouvez entreprendre une action supplémentaire (sauf l’action Magie). Une utilisation, récupérée au Repos court ou long (deux à partir du niveau 17, une seule par tour).",
      "effets": []
    },
    {
      "id": "sens-tactique",
      "nom": "Sens tactique",
      "niveau": 2,
      "resume": "Quand vous ratez un test de caractéristique, vous pouvez dépenser une utilisation de Second souffle pour ajouter 1d10 au test ; si le test échoue malgré tout, l’utilisation n’est pas dépensée.",
      "effets": []
    },
    {
