  "aptitudes": [
    {
      "id": "bottes-d-arme",
      "nom": "Bottes d’arme",
      "niveau": 1,
      "resume": "Peut utiliser la propriété Botte de deux types d’arme maîtrisés au choix ; il peut changer ce choix à chaque Repos long.",
      "effets": []
    },
    {
      "id": "imposition-des-mains",
      "nom": "Imposition des mains",
      "niveau": 1,
      "resume": "Réserve de soins égale à cinq fois le niveau de Paladin, reconstituée au Repos long. Par une action Bonus et un contact, rend des points de vie puisés dans la réserve, ou dépense 5 points pour retirer l’état Empoisonné.",
      "effets": []
    },
    {
      "id": "sorts",
      "nom": "Sorts",
      "niveau": 1,
      "resume": "Lance des sorts de Paladin avec le Charisme, via un symbole sacré. Emplacements récupérés au Repos long ; après un Repos long, peut remplacer un sort préparé.",
      "effets": []
    },
    {
      "id": "chatiment-de-paladin",
      "nom": "Châtiment de paladin",
      "niveau": 2,
      "resume": "Châtiment divin est toujours préparé, et il peut le lancer une fois sans dépenser d’emplacement de sort par Repos long.",
      "effets": []
    },
    {
      "id": "style-de-combat",
      "nom": "Style de combat",
      "niveau": 2,
      "resume": "Reçoit un don de Style de combat au choix, ou l’option Combattant béni : deux sorts mineurs de Clerc (assistance et flamme sacrée recommandés), lancés avec le Charisme comme sorts de Paladin.",
      "effets": []
    },
    {
      "id": "conduit-divin",
      "nom": "Conduit divin",
      "niveau": 3,
      "resume": "Deux utilisations de Conduit divin ; il en regagne une au Repos court et toutes au Repos long (une de plus au niveau 11). Effet de base, Perception divine : par une action Bonus, pendant 10 minutes, il localise Célestes, Fiélons et Morts-vivants ainsi que les lieux ou objets consacrés ou profanés à 18 m.",
      "effets": []
    },
    {
      "id": "amelioration-de-caracteristique",
      "nom": "Amélioration de caractéristique",
      "niveau": 4,
      "resume": "Reçoit le don Amélioration de caractéristique ou un autre don dont il remplit les conditions. Se répète aux niveaux 8, 12 et 16.",
      "effets": [
        {
          "type": "amelioration_caracteristique"
        }
      ]
    },
    {
      "id": "attaque-supplementaire",
      "nom": "Attaque supplémentaire",
      "niveau": 5,
      "resume": "Attaque deux fois au lieu d’une lorsqu’il entreprend l’action Attaque.",
      "effets": []
    },
    {
      "id": "fidele-destrier",
      "nom": "Fidèle destrier",
      "niveau": 5,
      "resume": "Appel de destrier est toujours préparé, et il peut le lancer une fois sans dépenser d’emplacement de sort par Repos long.",
      "effets": []
    },
    {
      "id": "aura-de-protection",
      "nom": "Aura de protection",
      "niveau": 6,
      "resume": "Aura indiscernable en Émanation de 3 m, inactive tant qu’il est Neutralisé. Lui-même et ses alliés dans l’aura reçoivent aux jets de sauvegarde un bonus égal à son modificateur de Charisme (minimum +1). Avec plusieurs Paladins, une créature ne bénéficie que d’une seule Aura de protection à la fois, à son choix.",
      "effets": []
    },
    {
      "id": "amelioration-de-caracteristique-8",
      "nom": "Amélioration de caractéristique",
      "niveau": 8,
      "resume": "Reçoit le don Amélioration de caractéristique ou un autre don dont il remplit les conditions.",
      "effets": [
        {
          "type": "amelioration_caracteristique"
        }
      ]
    },
    {
      "id": "abjuration-d-ennemis",
      "nom": "Abjuration d’ennemis",
      "niveau": 9,
      "resume": "Par l’action Magie, dépense une utilisation de Conduit divin : cible un nombre de créatures égal à son modificateur de Charisme (minimum une) vues à 18 m, qui doivent réussir un jet de sauvegarde de Sagesse sous peine d’être Effrayées pendant 1 minute ou jusqu’à ce qu’elles subissent des dégâts. Tant qu’elle est Effrayée, une cible ne peut faire qu’une seule chose à son tour : se déplacer, entreprendre une action ou une action Bonus.",
      "effets": []
    },
    {
      "id": "aura-de-courage",
      "nom": "Aura de courage",
      "niveau": 10,
      "resume": "Lui-même et ses alliés sont Immunisés contre l’état Effrayé au sein de son Aura de protection. Un allié Effrayé qui y pénètre voit cet état réprimé tant qu’il s’y trouve.",
      "effets": []
    },
    {
      "id": "frappes-radiantes",
      "nom": "Frappes radiantes",
      "niveau": 11,
      "resume": "Quand il touche une cible avec une attaque d’arme de corps à corps ou à mains nues, elle subit 1d8 dégâts radiants supplémentaires.",
      "effets": []
    },
    {
      "id": "amelioration-de-caracteristique-12",
      "nom": "Amélioration de caractéristique",
      "niveau": 12,
      "resume": "Reçoit le don Amélioration de caractéristique ou un autre don dont il remplit les conditions.",
      "effets": [
        {
          "type": "amelioration_caracteristique"
        }
      ]
    },
    {
      "id": "toucher-reparateur",
      "nom": "Toucher réparateur",
      "niveau": 14,
      "resume": "Quand il utilise Imposition des mains sur une créature, il peut aussi lui retirer un ou plusieurs états parmi Assourdi, Aveuglé, Charmé, Effrayé, Étourdi ou Paralysé, en dépensant 5 points de vie de la réserve par état supprimé ; ces points ne rendent pas de pv à la créature.",
      "effets": []
    },
    {
      "id": "amelioration-de-caracteristique-16",
      "nom": "Amélioration de caractéristique",
      "niveau": 16,
      "resume": "Reçoit le don Amélioration de caractéristique ou un autre don dont il remplit les conditions.",
      "effets": [
        {
          "type": "amelioration_caracteristique"
        }
      ]
    },
