      },
      {
        "id": "proie-du-chasseur",
        "nom": "Proie du chasseur",
        "niveau": 3,
        "resume": "Choisit une option, modifiable à chaque Repos court ou long : Briseur de hordes (une fois par tour, attaque supplémentaire avec la même arme contre une autre créature à 1,50 m de la cible) ou Goût du sang (une fois par tour, +1d8 dégâts contre une créature qui a perdu des points de vie).",
        "effets": []
      },
      {
        "id": "tactiques-defensives",
        "nom": "Tactiques défensives",
        "niveau": 7,
        "resume": "Choisit une option, modifiable à chaque Repos court ou long : Cauchemar de la horde (les attaques d’Opportunité contre lui subissent le Désavantage) ou Défense contre les attaques multiples (quand une créature le touche avec un jet d’attaque, elle subit le Désavantage à tous ses autres jets d’attaque contre lui pendant ce tour).",
        "effets": []
      },
      {
        "id": "proie-du-chasseur-superieure",
        "nom": "Proie du chasseur supérieure",
        "niveau": 11,
        "resume": "Une fois par tour, quand il inflige des dégâts à une créature marquée par sa marque du chasseur, il peut infliger aussi les dégâts supplémentaires de ce sort à une autre créature qu’il voit dans un rayon de 9 m de la première.",
        "effets": []
      },
      {
        "id": "defense-de-chasseur-superieure",
        "nom": "Défense de chasseur supérieure",
        "niveau": 15,
        "resume": "Quand il subit des dégâts, il peut jouer sa Réaction pour obtenir la Résistance aux éventuels autres dégâts du même type jusqu’à la fin de ce tour.",
        "effets": []
      }
    ]
  }
