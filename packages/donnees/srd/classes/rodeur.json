  "aptitudes": [
    {
      "id": "sorts",
      "nom": "Sorts",
      "niveau": 1,
      "resume": "Lance des sorts de Rôdeur avec la Sagesse, via un focaliseur druidique. Emplacements récupérés au Repos long ; après un Repos long, peut remplacer un sort préparé.",
      "effets": []
    },
    {
      "id": "ennemi-jure",
      "nom": "Ennemi juré",
      "niveau": 1,
      "resume": "Marque du chasseur est toujours préparé ; il peut le lancer sans emplacement de sort autant de fois qu’indiqué dans la colonne Ennemi juré (2, puis 3 au niveau 5), toutes ces utilisations revenant au Repos long.",
      "effets": []
    },
    {
      "id": "bottes-d-arme",
      "nom": "Bottes d’arme",
      "niveau": 1,
      "resume": "Peut utiliser la propriété Botte de deux types d’arme maîtrisés au choix ; il peut changer ce choix à chaque Repos long.",
      "effets": []
    },
    {
      "id": "fin-explorateur",
      "nom": "Fin explorateur",
      "niveau": 2,
      "resume": "Reçoit l’Expertise dans une compétence maîtrisée et apprend deux langues au choix.",
      "effets": [
        {
          "type": "expertise",
          "nombre": 1
        }
      ]
    },
    {
      "id": "style-de-combat",
      "nom": "Style de combat",
      "niveau": 2,
      "resume": "Reçoit un don de Style de combat au choix, ou l’option Combattant druidique : deux sorts mineurs de Druide (assistance et poussière d’étoile recommandés), lancés avec la Sagesse comme sorts de Rôdeur.",
      "effets": []
    },
    {
      "id": "amelioration-de-caracteristique",
      "nom": "Amélioration de caractéristique",
      "niveau": 4,
