  "aptitudes": [
    {
      "id": "sorts",
      "nom": "Sorts",
      "niveau": 1,
      "resume": "Vous lancez des sorts d’Ensorceleur avec le Charisme, en utilisant un focaliseur arcanique. Sorts mineurs, sorts préparés et emplacements suivent la table ; les emplacements reviennent au Repos long et vous pouvez changer un sort préparé à chaque niveau gagné.",
      "effets": []
    },
    {
      "id": "sorcellerie-innee",
      "nom": "Sorcellerie innée",
      "niveau": 1,
      "resume": "Par une action Bonus, vous libérez votre magie pendant 1 minute : le DD de sauvegarde de vos sorts d’Ensorceleur augmente de 1 et vous avez l’Avantage à leurs jets d’attaque. Deux utilisations, récupérées au Repos long.",
      "effets": []
    },
    {
      "id": "reserve-arcanique",
      "nom": "Réserve arcanique",
      "niveau": 2,
      "resume": "Vous disposez de points de Sorcellerie (colonne Points de sorcellerie), tous récupérés au Repos long. Vous pouvez dépenser un emplacement pour gagner autant de points que son niveau, ou, par une action Bonus, convertir des points en emplacement (1er niveau : 2 points ; 2e : 3 points ; 3e : 5 points, à partir du niveau 5 ; 4e : 6 ; 5e : 7) qui disparaît au Repos long.",
      "effets": []
    },
    {
      "id": "metamagie",
      "nom": "Métamagie",
      "niveau": 2,
      "resume": "Vous apprenez deux options de Métamagie, payées en points de Sorcellerie, pour modifier vos sorts (une seule option par sort sauf mention contraire). Vous pouvez en remplacer une à chaque niveau ; deux de plus aux niveaux 10 et 17.",
      "effets": []
    },
    {
      "id": "amelioration-de-caracteristique",
      "nom": "Amélioration de caractéristique",
      "niveau": 4,
      "resume": "Vous recevez le don Amélioration de caractéristique ou un autre don dont vous remplissez les conditions. Vous recevez de nouveau cette aptitude aux niveaux 8, 12 et 16.",
      "effets": [
        {
          "type": "amelioration_caracteristique"
        }
      ]
    },
    {
      "id": "restauration-ensorcelee",
      "nom": "Restauration ensorcelée",
      "niveau": 5,
      "resume": "En terminant un Repos court, vous récupérez des points de Sorcellerie dépensés à concurrence de la moitié de votre niveau d’Ensorceleur (arrondie à l’inférieur), une fois par Repos long.",
      "effets": []
    },
    {
      "id": "sorcellerie-incarnee",
      "nom": "Sorcellerie incarnée",
      "niveau": 7,
      "resume": "S’il ne vous reste aucune utilisation de Sorcellerie innée, vous pouvez y recourir en dépensant 2 points de Sorcellerie (action Bonus). Tant que Sorcellerie innée est active, vous pouvez utiliser jusqu’à deux options de Métamagie pour chaque sort lancé.",
      "effets": []
    },
    {
