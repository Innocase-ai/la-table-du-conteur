  "sousClasse": {
    "id": "evocateur",
    "nom": "Évocateur",
    "aptitudes": [
      {
        "id": "evocateur-erudit",
        "nom": "Évocateur érudit",
        "niveau": 3,
        "resume": "Ajoute gratuitement à son grimoire deux sorts de Magicien d’Évocation du 2e niveau au plus, puis un sort d’Évocation gratuit chaque fois qu’il accède à un nouveau niveau d’emplacements de sort.",
        "effets": []
      },
      {
        "id": "sort-mineur-appuye",
        "nom": "Sort mineur appuyé",
        "niveau": 3,
        "resume": "Quand un de ses sorts mineurs rate son jet d’attaque ou que la cible réussit son jet de sauvegarde, la cible subit quand même la moitié des dégâts du sort mineur, sans ses effets supplémentaires.",
        "effets": []
      },
      {
        "id": "faconneur-de-sorts",
        "nom": "Façonneur de sorts",
        "niveau": 6,
        "resume": "Quand il lance un sort d’Évocation qui affecte d’autres créatures qu’il voit, peut en désigner un nombre n’excédant pas 1 + le niveau du sort : elles réussissent automatiquement leur jet de sauvegarde contre le sort et ne subissent aucun dégât si elles devaient les réduire de moitié en cas de réussite.",
        "effets": []
      },
      {
        "id": "evocation-amelioree",
        "nom": "Évocation améliorée",
        "niveau": 10,
        "resume": "Chaque fois qu’il lance un sort de Magicien de l’école d’Évocation, peut ajouter son modificateur d’Intelligence à un jet de dégâts de ce sort.",
        "effets": []
      },
      {
        "id": "surcharge-magique",
        "nom": "Surcharge magique",
        "niveau": 14,
        "resume": "Lorsqu’il lance un sort de Magicien infligeant des dégâts avec un emplacement du 1er au 5e niveau, peut infliger le maximum de dégâts au tour où il le lance. La première fois, aucun effet indésirable ; en réutilisant l’aptitude avant un Repos long, il subit 2d12 dégâts nécrotiques par niveau de l’emplacement, juste après l’incantation (non affectés par la Résistance ni l’Immunité), +1d12 par niveau de sort à chaque nouvelle utilisation avant un Repos long.",
        "effets": []
      }
    ]
  }
