  "aptitudes": [
    {
      "id": "sorts",
      "nom": "Sorts",
      "niveau": 1,
      "resume": "Lance des sorts de Magicien avec l’Intelligence, via un focaliseur arcanique ou le grimoire. Le grimoire débute avec six sorts du 1er niveau et en reçoit deux de plus à chaque niveau de Magicien ; les sorts préparés sont choisis dans le grimoire et peuvent être changés après un Repos long, les emplacements se récupèrent au Repos long.",
      "effets": []
    },
    {
      "id": "savoir-rituel",
      "nom": "Savoir rituel",
      "niveau": 1,
      "resume": "Peut lancer comme rituel tout sort à mention « rituel » inscrit dans son grimoire, même non préparé, en le lisant dans le grimoire.",
      "effets": []
    },
    {
      "id": "restauration-magique",
      "nom": "Restauration magique",
      "niveau": 1,
      "resume": "En terminant un Repos court, récupère des emplacements de sort dépensés dont la somme des niveaux ne dépasse pas la moitié du niveau de Magicien (arrondie au supérieur), aucun du 6e niveau ou plus. Une fois par Repos long.",
      "effets": []
    },
    {
      "id": "erudition",
      "nom": "Érudition",
      "niveau": 2,
      "resume": "Reçoit l’Expertise dans une compétence maîtrisée parmi Arcanes, Histoire, Intuition, Investigation, Médecine, Nature ou Religion.",
