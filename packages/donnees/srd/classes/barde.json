  "aptitudes": [
    {
      "id": "inspiration-bardique",
      "nom": "Inspiration bardique",
      "niveau": 1,
      "resume": "Par une action Bonus, vous donnez un dé d’Inspiration bardique (d6, puis d8 au niveau 5) à une autre créature qui vous voit ou vous entend dans un rayon de 18 m ; dans l’heure, elle peut l’ajouter à un Test d20 raté. Utilisations égales à votre modificateur de Charisme (minimum 1), récupérées au Repos long.",
      "effets": []
    },
    {
      "id": "sorts",
      "nom": "Sorts",
      "niveau": 1,
      "resume": "Vous lancez des sorts de Barde avec le Charisme, en utilisant un instrument de musique comme focaliseur. Sorts mineurs, sorts préparés et emplacements suivent la table ; les emplacements reviennent au Repos long et vous pouvez changer un sort préparé à chaque niveau gagné.",
      "effets": []
    },
    {
      "id": "expertise",
      "nom": "Expertise",
      "niveau": 2,
      "resume": "Vous recevez l’Expertise dans deux compétences que vous maîtrisez (Persuasion et Représentation recommandées), puis dans deux autres au niveau 9.",
      "effets": [
